# Optional: omit to use the built-in sample mystery generator.
GEMINI_API_KEY=

# Recommended for persistent cases across deploys/restarts.
# Example: mongodb+srv://<user>:<password>@<cluster>/<database>?retryWrites=true&w=majority
MONGO_URI=

# Set by Render automatically. Local API defaults to port 5000.
PORT=5000
